# Resend email integration for the lead form.
# Copy to .env for local dev, and set these in Railway (Variables) for production.

# Required. Create in Resend › API Keys.
# NOTE: a "Sending"-only key can email but CANNOT save contacts. Use a
# Full-access key so each lead is also stored as a Resend contact.
RESEND_API_KEY=

# Where lead notifications are delivered. The send.verkoop.studio domain is verified
# in Resend, so this can be any inbox.
LEAD_TO=stefkeppens@gmail.com

# "From" address for the notification. Uses the verified send.verkoop.studio domain
# so it delivers to any recipient.
LEAD_FROM=Verkoop Studio <noreply@send.verkoop.studio>

# Optional confirmation reply to the person who submitted the form.
# Requires a VERIFIED domain, since it delivers to arbitrary addresses.
# LEAD_REPLY_FROM=Stef Keppens <stef@stefkeppens.be>

# Optional Resend segment for visitors who left a form unfinished. Create it in
# Resend > Segments (for example "Formulier niet afgerond") and paste its id.
# Without it, their email is still stored on the contact, just not grouped.
PARTIAL_LEAD_SEGMENT=

# Canonical production origin, set before npm run build.
VITE_SITE_URL=https://verkoop.studio

# Server-only CRM connection. Use a public HTTPS CRM URL in production.
CRM_INBOUND_URL=
CRM_INBOUND_TOKEN=

# Server-only OpenAI Ads Conversions API key for pixel RVGNA5NGiGauDpbp33VAqq.
# Create in Ads Manager > Conversions; this is not an OpenAI model API key.
# Leave empty to keep server-side conversion delivery disabled.
OPENAI_CONVERSIONS_API_KEY=
